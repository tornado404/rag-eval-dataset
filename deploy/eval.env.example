# Copy to ~/.config/rag-eval-dataset/eval.env and chmod 600.
# Values below are examples; replace endpoints, model names, keys and dataset IDs.
EVAL_TARGET=ragflow
EVAL_REWRITE_ENDPOINT=https://llm.example.com/v1/chat/completions
EVAL_REWRITE_MODEL=your-model
EVAL_REWRITE_API_KEY=
RAGFLOW_BASE_URL=https://ragflow.example.com
RAGFLOW_API_KEY=
RAGFLOW_DATASET_IDS=
EVAL_MAX_CASES=0
EVAL_REMOTE_TIMEOUT_MS=180000
M3_BASE_URL=https://api.example.com

# AI 问答真实链路（EVAL_TARGET=ai-qa / 页面选择“M3 AI 问答真实链路”）
# 用户身份只保存在服务端；优先只填 refresh token（7 天，服务端自动轮换）。
# 浏览器与 /api/eval/defaults 只能看到“已配置 / 未配置”，拿不到 token 明文。
M3_QA_USER_REFRESH_TOKEN=
M3_QA_USER_JWT=
# 评测服务用 docker logs 读取 turn_observation；留空自动探测后端容器。
M3_BACKEND_CONTAINER=
# Docker CLI 不在默认 PATH 时指定绝对路径。
DOCKER_BIN=
