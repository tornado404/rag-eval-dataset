{
  "name": "rag-eval-dataset",
  "version": "0.1.0",
  "private": true,
  "description": "Tools for evaluating RAG retrieval and answer behavior with separately provisioned datasets.",
  "scripts": {
    "editor": "node editor/server.mjs",
    "golden": "node editor/golden-server.mjs",
    "governance": "node scripts/golden-governance.mjs",
    "gate:p0-p1": "node scripts/golden-governance.mjs gate p0-p1 --split split-golden-v1-v1 --seed 42 --validation-ratio 0.2",
    "lint": "node scripts/lint.mjs",
    "check": "npm run lint && npm run validate && npm test",
    "validate": "node scripts/validate.mjs",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  }
}
