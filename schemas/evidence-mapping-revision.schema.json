{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Golden Evidence–Chunk mapping revision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mapping_id",
    "revision",
    "evidence_id",
    "experiment_version",
    "excerpt",
    "chunk_ids",
    "source_anchor",
    "source_digest",
    "review_status",
    "reviewer",
    "reviewed_at",
    "note",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": "golden-evidence-mapping/v1" },
    "mapping_id": { "type": "string", "minLength": 3 },
    "revision": { "type": "integer", "minimum": 1 },
    "evidence_id": { "type": "string", "minLength": 1 },
    "experiment_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "excerpt": { "type": "string", "minLength": 1 },
    "chunk_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "source_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "continuity_confirmed", "segments"],
      "properties": {
        "mode": { "enum": ["single_chunk", "consecutive_chunks"] },
        "continuity_confirmed": { "type": "boolean" },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["chunk_id", "start_offset", "end_offset", "quote", "chunk_sha256"],
            "properties": {
              "chunk_id": { "type": "string", "minLength": 1 },
              "start_offset": { "type": "integer", "minimum": 0 },
              "end_offset": { "type": "integer", "minimum": 1 },
              "quote": { "type": "string", "minLength": 1 },
              "chunk_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        }
      }
    },
    "source_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "review_status": { "enum": ["pending", "approved", "rejected"] },
    "reviewer": { "type": "string" },
    "reviewed_at": { "type": "string" },
    "note": { "type": "string" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "review_status": { "enum": ["approved", "rejected"] } } },
      "then": {
        "properties": {
          "reviewer": { "type": "string", "minLength": 1 },
          "reviewed_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review_status": { "const": "approved" },
          "source_anchor": { "properties": { "mode": { "const": "consecutive_chunks" } } }
        }
      },
      "then": { "properties": { "source_anchor": { "properties": { "continuity_confirmed": { "const": true } } } } }
    }
  ]
}
